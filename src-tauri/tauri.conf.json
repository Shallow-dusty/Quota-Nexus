{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quota Nexus",
  "version": "0.1.5",
  "identifier": "com.quotanexus.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quota Nexus",
        "visible": false,
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {"installerHooks": "installer-hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
